############################################################
# audible-epub3-maker example environment configuration
#
# 1. Copy this file to `.env` (same directory) and adjust values.
# 2. Any value left blank will typically fall back to an internal default.
############################################################

########################
# General Environment
########################
# Set to production | development | dev
AUDIBLE_EPUB3_MAKER_ENV=production

########################
# Azure TTS (default engine)
########################
# Required if you use the Azure engine (tts_engine=azure)
AZURE_TTS_KEY=your_azure_speech_key
AZURE_TTS_REGION=your_speech_region

########################
# Chatterbox TTS (self-hosted) engine
########################
# Base URL of your Chatterbox server (no trailing slash preferred). Default: http://localhost:4123
CHATTERBOX_TTS_URL=http://localhost:4123

# Emotion / prosody exaggeration intensity (float). Default: 0.5
CHATTERBOX_EXAGGERATION=0.5

# CFG weight (float) – higher can increase pacing control / stability. Default: 0.5
CHATTERBOX_CFG_WEIGHT=0.5

# Sampling temperature (float) – higher = more random. Default: 0.8
CHATTERBOX_TEMPERATURE=0.8

# Optional explicit voice name override. If unset, falls back to CLI --voice or internal default.
CHATTERBOX_VOICE=

########################
# Notes
########################
# Precedence rules for Chatterbox voice selection:
#  1) CLI flag --chatterbox-voice (if provided)
#  2) CHATTERBOX_VOICE (this file)
#  3) CLI flag --voice / settings.tts_voice
# Adjust exaggeration/cfg_weight/temperature via CLI overrides if desired.
